{
  "routes": [
    {
      "routePath": "/api/bank-sms",
      "mountPath": "/api",
      "method": "GET",
      "module": [
        "api/bank-sms.js:onRequestGet"
      ]
    },
    {
      "routePath": "/api/bank-sms",
      "mountPath": "/api",
      "method": "POST",
      "module": [
        "api/bank-sms.js:onRequestPost"
      ]
    },
    {
      "routePath": "/api/play",
      "mountPath": "/api",
      "method": "GET",
      "module": [
        "api/play.js:onRequestGet"
      ]
    },
    {
      "routePath": "/api/poster",
      "mountPath": "/api",
      "method": "POST",
      "module": [
        "api/poster.js:onRequestPost"
      ]
    },
    {
      "routePath": "/hls/:path*",
      "mountPath": "/hls",
      "method": "GET",
      "module": [
        "hls/[[path]].js:onRequestGet"
      ]
    },
    {
      "routePath": "/p/:path*",
      "mountPath": "/p",
      "method": "GET",
      "module": [
        "p/[[path]].js:onRequestGet"
      ]
    },
    {
      "routePath": "/v/:path*",
      "mountPath": "/v",
      "method": "GET",
      "module": [
        "v/[[path]].js:onRequestGet"
      ]
    }
  ],
  "baseURL": "/"
}